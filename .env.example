# PayDunya Live / Sandbox API Keys (Required for real Wave & Orange Money Boost payments)
# Obtain from https://app.paydunya.com -> Applications -> API Keys
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_TOKEN=
# Set to "sandbox" for PayDunya sandbox testing, or "live" for real Wave / Orange Money payments
PAYDUNYA_MODE=live

# Public base URL of the app (used for PayDunya callback_url and return_url)
APP_BASE_URL=https://your-app-domain.run.app

# Optional: set to "true" in production if Boost calls should invoke deployed Firebase Cloud Functions instead of /api/boost/*
VITE_USE_FIREBASE_FUNCTIONS=false
